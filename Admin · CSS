/* BARBER BOOKING — admin */
body{display:flex}
.sidebar{width:228px;flex-shrink:0;background:#fff;border-left:1px solid var(--line);display:flex;flex-direction:column;height:100vh;position:sticky;top:0;overflow-y:auto}
.sb-brand{padding:18px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px;font-weight:800}
.sb-nav{flex:1;padding:12px 8px;display:flex;flex-direction:column;gap:2px}
.nav{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:12px;border:none;background:transparent;color:var(--ink2);font-size:.9rem;font-weight:600;cursor:pointer;width:100%;text-align:right;text-decoration:none}
.nav:hover{background:var(--bg)}
.nav.on{background:rgba(184,134,11,.12);color:var(--gold-d);font-weight:800}
.nav .badge{margin-right:auto;background:var(--red);color:#fff;font-size:.65rem;padding:2px 7px;border-radius:var(--pill)}
.sb-foot{padding:10px 8px;border-top:1px solid var(--line)}
.main{flex:1;min-width:0;padding:26px 24px 60px}
.mob{display:none}

.tab-p{display:none}.tab-p.on{display:block}
.ph{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:20px}
.ph h1{font-size:1.6rem;font-weight:800}
.acts{display:flex;gap:8px;flex-wrap:wrap}

.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
.stat{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:14px 16px;box-shadow:var(--sh)}
.stat .k{font-size:.72rem;color:var(--ink3);font-weight:600}
.stat .v{font-size:1.4rem;font-weight:800;margin-top:2px}

/* queue board */
.board{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:16px;align-items:start}
.col{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);box-shadow:var(--sh);overflow:hidden}
.col-h{padding:14px 16px;background:var(--ink);color:#fff;display:flex;justify-content:space-between;align-items:center}
.col-h b{font-size:1rem}
.col-h span{font-size:.74rem;color:var(--gold-l)}
.col-b{padding:10px;display:flex;flex-direction:column;gap:8px;min-height:70px}
.q-item{display:flex;gap:10px;padding:10px;border-radius:14px;background:var(--bg);border:1.5px solid transparent}
.q-item.in_service{background:rgba(45,106,79,.09);border-color:rgba(45,106,79,.35)}
.q-no{width:38px;height:38px;border-radius:10px;background:var(--ink);color:var(--gold-l);font-weight:800;font-size:.85rem;display:grid;place-items:center;flex-shrink:0}
.q-body{flex:1;min-width:0;font-size:.85rem}
.q-body b{font-size:.92rem}
.q-body a{color:var(--blue);text-decoration:none;direction:ltr;display:inline-block;font-size:.78rem;margin-inline-start:6px}
.q-act{display:flex;flex-direction:column;gap:4px}
.q-empty{text-align:center;color:var(--ink3);font-size:.84rem;padding:18px 0}

/* tables */
.tbl-w{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);overflow:auto;box-shadow:var(--sh)}
.tbl{width:100%;border-collapse:collapse;min-width:520px}
.tbl th{background:var(--bg);color:var(--ink3);font-size:.72rem;font-weight:700;padding:11px 14px;text-align:right;white-space:nowrap}
.tbl td{padding:12px 14px;border-top:1px solid var(--line);font-size:.86rem;vertical-align:middle}
.tbl .r{text-align:left;white-space:nowrap}
.gold{color:var(--gold-d);font-weight:800}
.tog{width:38px;height:21px;appearance:none;background:rgba(0,0,0,.15);border-radius:var(--pill);cursor:pointer;position:relative;border:none;transition:background var(--tr)}
.tog:checked{background:var(--green)}
.tog::after{content:'';position:absolute;top:2.5px;right:2.5px;width:16px;height:16px;background:#fff;border-radius:50%;transition:transform var(--tr)}
.tog:checked::after{transform:translateX(-17px)}

.chk-list{display:flex;flex-direction:column;gap:6px;max-height:190px;overflow-y:auto;border:1.5px solid var(--line);border-radius:12px;padding:8px;background:var(--bg)}
.chk-list label{display:flex;align-items:center;gap:8px;font-size:.86rem;cursor:pointer}

/* login */
.login{position:fixed;inset:0;z-index:900;background:var(--bg);display:flex;align-items:center;justify-content:center;padding:20px}
.login-box{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:36px 30px;width:100%;max-width:380px;box-shadow:var(--sh-h);text-align:center}
.login-box h1{font-size:1.4rem;font-weight:800;margin:12px 0 4px}
.login-err{display:none;background:rgba(192,57,43,.08);color:var(--red);border-radius:12px;padding:10px;font-size:.84rem;font-weight:700;margin-top:12px}

@media(max-width:900px){
  .sidebar{position:fixed;right:-240px;top:0;z-index:300;transition:right var(--tr)}
  .sidebar.open{right:0;box-shadow:-12px 0 40px rgba(0,0,0,.15)}
  .mob{display:flex;position:fixed;top:0;inset-inline:0;z-index:200;background:rgba(255,255,255,.96);border-bottom:1px solid var(--line);padding:10px 16px;align-items:center;justify-content:space-between}
  .mob button{background:none;border:none;font-size:1.4rem;cursor:pointer}
  .main{padding:68px 14px 60px}
  .stats{grid-template-columns:repeat(2,1fr)}
}
