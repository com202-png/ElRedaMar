/* BARBER BOOKING — shared styles */
:root{
  --bg:#f6f3ee;--card:#fff;--ink:#16120e;--ink2:#5a4d3c;--ink3:#9a8c7a;
  --gold:#b8860b;--gold-l:#d4a843;--gold-d:#8b6308;
  --line:rgba(0,0,0,.09);--line-g:rgba(184,134,11,.3);
  --green:#2d6a4f;--red:#c0392b;--blue:#1a56a4;
  --r:16px;--r-lg:22px;--pill:999px;
  --sh:0 4px 24px rgba(60,40,10,.09);--sh-h:0 12px 40px rgba(60,40,10,.16);
  --tr:.2s cubic-bezier(.4,0,.2,1);
  font-family:'Tajawal',system-ui,sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);min-height:100vh;-webkit-font-smoothing:antialiased}
button,input,select,textarea{font-family:inherit}
.mut{font-size:.76rem;color:var(--ink3)}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:11px 22px;border-radius:var(--pill);border:none;font-size:.9rem;font-weight:700;cursor:pointer;transition:all var(--tr);text-decoration:none;white-space:nowrap}
.btn-gold{background:linear-gradient(135deg,var(--gold-l),var(--gold-d));color:#fff;box-shadow:0 6px 18px rgba(184,134,11,.3)}
.btn-gold:hover{transform:translateY(-2px)}
.btn-dark{background:var(--ink);color:#fff}
.btn-dark:hover{background:var(--gold-d)}
.btn-line{background:transparent;border:1.5px solid var(--line-g);color:var(--ink)}
.btn-line:hover{background:rgba(184,134,11,.08)}
.btn-red{background:rgba(192,57,43,.1);color:var(--red)}
.btn-green{background:rgba(45,106,79,.12);color:var(--green)}
.btn-sm{padding:6px 13px;font-size:.78rem}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none!important}

/* header */
.top{position:sticky;top:0;z-index:100;background:rgba(246,243,238,.96);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.top-in{max-width:1100px;margin:0 auto;padding:0 20px;height:64px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:1.05rem}
.logo-mark{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,var(--gold-l),var(--gold-d));color:#fff;display:grid;place-items:center;font-size:1.15rem}

/* hero */
.hero{background:var(--ink);color:#fff;text-align:center;padding:48px 20px 56px;position:relative;overflow:hidden}
.hero::after{content:'';position:absolute;inset:auto -60px -90px auto;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(212,168,67,.25),transparent 65%)}
.hero h1{font-size:clamp(1.7rem,4.5vw,2.7rem);font-weight:800;line-height:1.25;margin-bottom:10px}
.hero h1 em{color:var(--gold-l);font-style:normal}
.hero p{color:rgba(255,255,255,.72);max-width:520px;margin:0 auto;line-height:1.7}
.closed-banner{display:none;background:var(--red);color:#fff;text-align:center;padding:10px;font-weight:700;font-size:.9rem}

/* steps */
.wrap{max-width:1100px;margin:0 auto;padding:8px 20px 140px}
.step{margin-top:36px}
.step h2{display:flex;align-items:center;gap:10px;font-size:1.25rem;font-weight:800;margin-bottom:16px}
.num{width:30px;height:30px;border-radius:50%;background:var(--ink);color:#fff;font-size:.85rem;display:grid;place-items:center}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}

.card{background:var(--card);border:2px solid var(--line);border-radius:var(--r-lg);padding:16px;cursor:pointer;transition:all var(--tr);position:relative;text-align:right}
.card:hover{box-shadow:var(--sh);border-color:var(--line-g)}
.card.sel{border-color:var(--gold);box-shadow:0 0 0 4px rgba(184,134,11,.13)}
.card.sel::after{content:'✓';position:absolute;top:10px;left:10px;width:24px;height:24px;border-radius:50%;background:var(--gold);color:#fff;font-size:.8rem;display:grid;place-items:center}
.avatar{width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#ece4d4,#d9cdb5);display:grid;place-items:center;font-size:1.6rem;font-weight:800;color:var(--gold-d);overflow:hidden;margin-bottom:10px}
.avatar img{width:100%;height:100%;object-fit:cover}
.c-name{font-weight:800;font-size:1rem}
.c-sub{font-size:.8rem;color:var(--ink3);margin-top:2px;min-height:1.1em}
.q-pill{display:inline-block;margin-top:10px;padding:4px 11px;border-radius:var(--pill);font-size:.74rem;font-weight:700;background:rgba(45,106,79,.1);color:var(--green)}
.q-pill.busy{background:rgba(184,134,11,.12);color:var(--gold-d)}

.tabs{display:flex;gap:8px;margin-bottom:16px}
.tab{padding:9px 20px;border-radius:var(--pill);border:1.5px solid var(--line-g);background:#fff;font-weight:700;font-size:.86rem;cursor:pointer;color:var(--ink2)}
.tab.on{background:var(--ink);border-color:var(--ink);color:#fff}
.svc{display:flex;flex-direction:column;gap:6px}
.svc .row{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.svc .p{font-weight:800;color:var(--gold-d);white-space:nowrap}
.svc .d{font-size:.78rem;color:var(--ink3)}
.old{text-decoration:line-through;color:var(--ink3);font-weight:500;font-size:.8rem;margin-inline-start:6px}
.badge-pk{display:inline-block;background:var(--ink);color:var(--gold-l);font-size:.68rem;font-weight:700;padding:3px 9px;border-radius:var(--pill);width:max-content}

/* forms */
.form{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:14px;box-shadow:var(--sh)}
.fg{display:flex;flex-direction:column;gap:6px}
.fg.full{grid-column:1/-1}
.fg label{font-size:.8rem;font-weight:700;color:var(--ink2)}
.fg input,.fg select,.fg textarea{padding:11px 14px;border-radius:12px;border:1.5px solid var(--line);background:var(--bg);font-size:.92rem;color:var(--ink);outline:none;transition:border-color var(--tr)}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--gold);background:#fff}

/* sticky book bar */
.bar{position:fixed;bottom:0;inset-inline:0;z-index:150;background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-top:1px solid var(--line);box-shadow:0 -6px 30px rgba(60,40,10,.1)}
.bar-in{max-width:1100px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;justify-content:space-between;gap:14px}
.bar-sum{display:flex;gap:22px;flex-wrap:wrap}
.bar-sum .k{font-size:.7rem;color:var(--ink3)}
.bar-sum .v{font-weight:800;font-size:.98rem}

/* modal */
.mo{position:fixed;inset:0;background:rgba(22,18,14,.55);backdrop-filter:blur(6px);z-index:500;display:flex;align-items:center;justify-content:center;padding:18px;opacity:0;pointer-events:none;transition:opacity var(--tr)}
.mo.open{opacity:1;pointer-events:auto}
.mo-box{background:#fff;border-radius:var(--r-lg);padding:26px;width:100%;max-width:460px;max-height:92vh;overflow-y:auto;box-shadow:0 24px 80px rgba(22,18,14,.25);transform:translateY(14px) scale(.97);transition:transform var(--tr)}
.mo.open .mo-box{transform:none}
.mo-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.mo-head h2{font-size:1.15rem;font-weight:800}
.mo-x{width:32px;height:32px;border:none;border-radius:8px;background:var(--bg);cursor:pointer;font-size:1rem}
.mo-foot{display:flex;gap:8px;justify-content:flex-end;margin-top:18px}

.ticket{text-align:center}
.ticket .ok{font-size:2.6rem}
.ticket h3{font-size:1.25rem;font-weight:800;margin:6px 0 2px}
.t-no{display:inline-block;margin:12px 0;padding:8px 26px;border-radius:var(--r);background:var(--ink);color:var(--gold-l);font-size:1.7rem;font-weight:800;letter-spacing:.04em}
.t-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0;text-align:right}
.t-cell{background:var(--bg);border-radius:14px;padding:12px}
.t-cell .k{font-size:.72rem;color:var(--ink3)}
.t-cell .v{font-weight:800;font-size:1rem;margin-top:2px}
.t-cell.hl{background:rgba(184,134,11,.12)}
.note{font-size:.76rem;color:var(--ink3);line-height:1.6}

.trk{border:1px solid var(--line);border-radius:var(--r);padding:14px;margin-top:12px;background:var(--bg)}
.trk-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.trk-no{font-weight:800;font-size:1.05rem}
.st{padding:3px 11px;border-radius:var(--pill);font-size:.72rem;font-weight:700}
.st.waiting{background:rgba(184,134,11,.14);color:var(--gold-d)}
.st.in_service{background:rgba(45,106,79,.14);color:var(--green)}
.st.done{background:rgba(45,106,79,.14);color:var(--green)}
.st.cancelled,.st.no_show{background:rgba(192,57,43,.12);color:var(--red)}

/* toast */
#tc{position:fixed;top:78px;left:50%;transform:translateX(-50%);z-index:999;display:flex;flex-direction:column;gap:8px;pointer-events:none;align-items:center}
.tst{padding:11px 18px;border-radius:14px;background:var(--ink);color:#fff;font-size:.88rem;font-weight:600;box-shadow:0 8px 28px rgba(0,0,0,.2);animation:tin .25s ease both}
.tst.ok{background:var(--green)}.tst.err{background:var(--red)}
.tst.hid{opacity:0;transition:opacity .25s}
@keyframes tin{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}

footer{background:var(--ink);color:rgba(255,255,255,.6);text-align:center;padding:20px;font-size:.8rem}
footer a{color:var(--gold-l);text-decoration:none}

.empty{grid-column:1/-1;text-align:center;padding:36px;color:var(--ink3)}

@media(max-width:640px){
  .form{grid-template-columns:1fr}
  .grid{grid-template-columns:repeat(2,1fr);gap:10px}
  .bar-sum{gap:14px}
  .bar-in{padding:10px 14px}
  .btn-book{padding:11px 18px}
}
